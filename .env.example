# =============================================================================
# HR Lifecycle Integration Service - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# ── MongoDB ────────────────────────────────────────────────────────────────
# Atlas URI for production: mongodb+srv://user:pass@cluster.mongodb.net/hrdb
# Local (docker-compose): mongodb://mongo:27017/hrdb
MONGODB_URI=mongodb://mongo:27017/hrdb
MONGODB_DB_NAME=hrdb

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORRELATION_ID_HEADER=X-Correlation-ID

# ── JWT / Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-real-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Webhook / Outbox Worker ────────────────────────────────────────────────
WEBHOOK_HMAC_SECRET=changeme-webhook-hmac-secret
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_RETRIES=5
OUTBOX_BACKOFF_BASE_SECONDS=2
# Max wait between retries: backoff_base^retry capped at this value
OUTBOX_BACKOFF_MAX_SECONDS=60
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10

# ── Mock Downstream ────────────────────────────────────────────────────────
MOCK_DOWNSTREAM_URL=http://mock_downstream:9000
MOCK_DOWNSTREAM_PORT=9000
# Probability (0.0-1.0) the mock downstream randomly fails a request
MOCK_FAILURE_RATE=0.3

# ── Seeding ────────────────────────────────────────────────────────────────
SEED_EMPLOYEE_COUNT=50
SEED_RANDOM_SEED=42
